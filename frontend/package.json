{
  "name": "@frontend/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "npx nx serve intapp-suite",
    "test": "nx run-many --target=test --all",
    "test:auth": "npx nx test auth",
    "test:termsheet": "npx nx test termsheet",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "lint:affected": "nx affected --target=lint",
    "lint:affected:fix": "nx affected --target=lint --fix",
    "lint:deps": "depcruise libs apps",
    "format": "prettier --write \"{apps,libs}/**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.{ts,html,scss,json,md}\"",
    "build": "npx nx build intapp-suite",
    "graph": "npx nx graph",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~17.3.0",
    "@angular/common": "~17.3.0",
    "@angular/compiler": "~17.3.0",
    "@angular/core": "~17.3.0",
    "@angular/forms": "~17.3.0",
    "@angular/platform-browser": "~17.3.0",
    "@angular/platform-browser-dynamic": "~17.3.0",
    "@angular/router": "~17.3.0",
    "@auth0/angular-jwt": "^5.2.0",
    "@ngrx/signals": "~17.2.0",
    "@nx/angular": "18.3.5",
    "fast-deep-equal": "^3.1.3",
    "lodash": "^4.18.1",
    "primeicons": "~7.0.0",
    "primeng": "~17.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~17.3.0",
    "@angular-devkit/core": "~17.3.0",
    "@angular-devkit/schematics": "~17.3.0",
    "@angular-eslint/eslint-plugin": "~17.3.0",
    "@angular-eslint/eslint-plugin-template": "~17.3.0",
    "@angular-eslint/template-parser": "~17.3.0",
    "@angular/cli": "~17.3.0",
    "@angular/compiler-cli": "~17.3.0",
    "@angular/language-service": "~17.3.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-angular": "^19.0.0",
    "@commitlint/config-nx-scopes": "^19.0.0",
    "@nx/eslint": "18.3.5",
    "@nx/eslint-plugin": "18.3.5",
    "@nx/jest": "18.3.5",
    "@nx/js": "18.3.5",
    "@nx/workspace": "18.3.5",
    "@schematics/angular": "~17.3.0",
    "@swc-node/register": "~1.8.0",
    "@swc/core": "~1.3.85",
    "@swc/helpers": "~0.5.2",
    "@types/jest": "^29.4.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "^7.3.0",
    "@typescript-eslint/parser": "^7.3.0",
    "autoprefixer": "^10.4.0",
    "commitlint-plugin-function-rules": "^4.0.2",
    "dependency-cruiser": "^16.0.0",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-preset-angular": "~14.0.3",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^15.5.2",
    "ng-packagr": "~17.3.0",
    "nx": "18.3.5",
    "postcss": "^8.4.5",
    "postcss-url": "~10.1.3",
    "prettier": "^3.8.3",
    "prettier-plugin-angular": "~0.3.2",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "~5.4.2"
  },
  "lint-staged": {
    "*.{ts,js,jsx,tsx,html,json,md,scss,css}": [
      "prettier --write"
    ]
  }
}
