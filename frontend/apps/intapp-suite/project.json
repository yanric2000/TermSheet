{
  "name": "intapp-suite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/intapp-suite/src",
  "tags": [
    "scope:app",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/intapp-suite",
        "index": "apps/intapp-suite/src/index.html",
        "main": "apps/intapp-suite/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/intapp-suite/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/intapp-suite/src/favicon.ico",
          "apps/intapp-suite/src/assets"
        ],
        "styles": [
          "apps/intapp-suite/src/styles.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "5mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "12kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/intapp-suite/src/environments/environment.ts",
              "with": "apps/intapp-suite/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "proxyConfig": "apps/intapp-suite/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "intapp-suite:build:production"
        },
        "development": {
          "buildTarget": "intapp-suite:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "intapp-suite:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/intapp-suite/jest.config.ts"
      }
    }
  }
}